extends "res://tests/v018_test.gd"

func _initialize() -> void:
	_catalog()
	_new_data()
	_prison()
	_plunder()
	_poison()
	_amulets()
	_random_matches()
	print("V020_RESULT checks=%d failures=%d" % [checks,failures])
	quit(0 if failures == 0 else 1)

func _new_data() -> void:
	var g = H.fixture(8)
	check(g.death_catalog[104].name == "凋萎", "deathrattle renamed")
	check(g.snapshot(0).catalog[104].type == "诅咒", "wither in hand belongs to curse category")
	check(g.death_catalog[112].text == "指定一个棋子：若它有可以打出的手牌，则它不能摸牌。", "prison explicit description")
	for key in g.AMULETS + g.GEMS:
		var id: int = H.give(g,0,key)
		var a: Dictionary = g._add_action(0,id)
		check(g.catalog[id].text.contains("\n") and g._target_description(a).contains("\n"), "document paragraph retained "+key)
	check(g.POISON.text.count("\n") == 2 and g.BOULDER.type == "诅咒" and g.POISON.type == "诅咒", "generated curse types and multiline poison")
	var plunder: int = H.give(g,0,"plunder")
	check(g.catalog[plunder].main == 1 and g.catalog[plunder].secondary == 1, "confirmed plunder rank")
	check(g.catalog[H.give(g,0,"poisoning")].main == 2, "poisoning rank")

func _prison() -> void:
	var g = H.fixture(8)
	activate(g,1,"prison",0)
	curse(g,0)
	var rock: int = g._generate_card(g.BOULDER)
	g.characters[0].hand.append(rock)
	var locked: int = H.give(g,0,"strike")
	g.defiled_cards[locked] = true
	check(not g._draw_blocked(g.characters[0]), "only unplayable cards do not block prison draw")
	g._draw(g.characters[0],1)
	check(g.characters[0].hand.size() == 4, "prison accepts draw with curses and defiled cards")
	H.give(g,0,"heal")
	check(g._draw_blocked(g.characters[0]), "a playable skill blocks prison draw")
	var before: int = g.characters[0].hand.size()
	g._push([{"op":"draw","target":0,"count":2}]);g._pump()
	check(g.characters[0].hand.size() == before, "interactive draw uses same prison eligibility")
	g = H.fixture(8);activate(g,1,"prison",0)
	var poison: int = g._generate_card(g.POISON)
	g.characters[0].hand.append(poison);g.defiled_cards[poison] = true
	H.give(g,0,"strike")
	check(not g._draw_blocked(g.characters[0]), "defiled poison and prohibited attacks cannot lock prison draw")
	g.defiled_cards.erase(poison)
	check(g._draw_blocked(g.characters[0]), "playable poison itself blocks prison draw")
	g = H.fixture(8);activate(g,1,"prison",0);curse(g,0)
	activate(g,3,"divinity");g.characters[3].hp = 0
	g._push([{"op":"draw","target":0,"count":1}]);g._pump()
	check(g.request.get("type","") == "deck", "prison with only wither still reaches divinity picker")
	g.pick(1,[g.request.options[0]])
	check(g.characters[0].hand.size() == 2, "divinity draw accepted")

func _plunder() -> void:
	for target_id in [0,1,3]:
		var g = H.fixture(8)
		var wanted: int = H.give(g,target_id,"holy_amulet")
		var other: int = H.give(g,target_id,"heal")
		g.defiled_cards[wanted] = true
		H.begin(g,{0:H.give(g,0,"plunder")})
		check(g.request.options.has(target_id), "plunder allows self, ally and enemy")
		g.target(0,target_id)
		if g.phase == "responding": g.respond(1,0)
		check(g.request.type == "plunder" and g.request.options.has(wanted) and g.request.options.has(other), "plunder shows entire hand")
		check(g.snapshot(1).input.options.is_empty() and g.snapshot(0).input.options.size() == 2, "plunder options private")
		check(g.snapshot(0).catalog[wanted].get("defiled",false), "plunder shows physical restriction")
		check(g.pick(1,[wanted]) != "" and g.pick(0,[]) != "", "plunder rejects other player and empty pick")
		g.pick(0,[wanted])
		check(g.characters[0].hand.has(wanted) and g.defiled_cards.has(wanted), "chosen exact physical card and restriction transfer")
		check(g.characters[target_id].hand.has(other), "unselected card remains with target")
		check(not str(g.log_lines).contains("神圣护符"), "declined amulet and stolen card name not leaked in log")
	var g = H.fixture(8)
	curse(g,3);g.characters[3].curse_exposed = true
	H.begin(g,{0:H.give(g,0,"plunder")});g.target(0,3);g.pick(0,[104])
	check(g.characters[0].hand.has(104) and not g.characters[0].curse_exposed, "plunder transfers wither privately without discarding")
	g = H.fixture(8)
	H.begin(g,{0:H.give(g,0,"plunder")});g.target(0,3)
	check(g.phase == "review", "empty target completes plunder")
	g = H.fixture(8);var kept: int = H.give(g,3,"strike")
	H.begin(g,{0:H.give(g,0,"plunder")});g.target(0,3);g.skip_effect(0)
	check(g.characters[3].hand.has(kept), "skipping picker transfers nothing")
	g = H.fixture(8);g._draw(g.characters[0],8)
	var stolen: int = H.give(g,3,"heal")
	H.begin(g,{0:H.give(g,0,"plunder")});g.target(0,3);g.pick(0,[stolen])
	check(g.request.is_empty(), "plunder overflow completes without an extra choice")
	check(g.characters[0].hand.size() == 8 and g.discard.has(stolen), "plunder overflow discards incoming card without replacing existing cards")

func _poison() -> void:
	var g = H.fixture(8)
	H.begin(g,{0:H.give(g,0,"poisoning")});g.target(0,3)
	var poison: int = g.characters[3].hand[0]
	check(g.catalog[poison].key == "poison" and g.catalog[poison].generated, "poisoning generates token in target hand")
	var strike: int = H.give(g,3,"strike")
	var skill: int = H.give(g,3,"magic_strike")
	check(not g._can_play_hand_card(g.characters[3],strike) and g._can_play_hand_card(g.characters[3],skill), "poison bans only attack cards")
	check(not g.snapshot(1).catalog[strike].playable and g.snapshot(0).catalog[strike].get("playable",true), "attack restriction shown only for visible hands")
	check(g._can_play_hand_card(g.characters[3],poison) and not g._can_discard_hand_card(g.characters[3],poison), "poison playable but cannot be discarded")
	g.phase = "planning";g.plans = [null,null];g.queue.clear()
	check(g.submit(1,[strike,0,0]) != "", "host rejects poisoned attack plan")
	g._discard_hand(g.characters[3])
	check(g.characters[3].hand == [poison], "discard all retains poison")
	activate(g,0,"blessing",3)
	H.begin(g,{3:poison})
	check(g.characters[3].hp == 7 and g.discard.has(poison), "played poison loses HP through blessing and completes normally")
	check(not g._has_poison(g.characters[3]), "poison prohibition ends on leaving hand")
	g = H.fixture(8)
	poison = g._generate_card(g.POISON);g.characters[0].hand.append(poison)
	strike = H.give(g,0,"strike")
	H.begin(g,{0:H.give(g,0,"frenzy")})
	check(g.characters[0].hand.has(strike) and g.characters[0].hp == 7, "frenzy snapshots eligibility before removing poison")
	g = H.fixture(8)
	poison = g._generate_card(g.POISON);g.characters[0].hand.append(poison)
	for _i in range(20): check(g.catalog[g._random_strike_id(0)].type != "攻击", "poison also prevents ghost attack plays")
	var source: int = H.give(g,3,"strike")
	var action: Dictionary = g._add_action(3,source)
	g.mirrors.append({"actor":0,"target":action.id});g._mirror_flip(action.id)
	check(g.queue.size() == 1, "poison prevents mirror attack copies")
	g = H.fixture(8)
	var poisoning: int = H.give(g,0,"poisoning")
	g._draw(g.characters[3],8)
	H.begin(g,{0:poisoning});g.target(0,3)
	check(g.request.is_empty() and g.phase == "review", "poison on full hand completes without a discard prompt")
	check(g.discard.any(func(id):return g.catalog[id].key == "poison"), "overflow poison is discarded despite its restriction")
	check(g.characters[3].hand.size() == 8 and not g._has_poison(g.characters[3]), "rejected poison does not prevent attacks")

func _amulets() -> void:
	for key in H.Rules.AMULETS:
		var g = H.fixture(8)
		var guard: int = H.give(g,0,key)
		H.begin(g,{0:guard})
		check(g.phase == "targeting" and g.input_action.card == guard, "played amulet resolves as target choice "+key)
		g.target(0,4)
		check(g.characters[4].hand.has(guard) and not g.discard.has(guard), "amulet physical transfer "+key)
		g.advance_round()
		check(g.characters[4].hand.has(guard), "amulet stays between rounds "+key)
		g = H.fixture(8)
		guard = H.give(g,3,key)
		activate(g,0,"privilege")
		var attack: int = H.give(g,0,"magic_strike" if key == "magic_amulet" else "strike")
		H.begin(g,{0:attack});g.target(0,3)
		check(g.phase == "responding" and g.request.options == [guard], "hand amulet reacts independent of source priority "+key)
		check(g.snapshot(0).input.options.is_empty() and not g.snapshot(0).input.description.contains(g.catalog[guard].name), "unaccepted amulet identity private")
		check(g.respond(0,guard) != "" and g.respond(1,attack) != "", "amulet input authority and validation")
		g.respond(1,guard)
		check(g.characters[3].hp == 8 and g.discard.count(guard) == 1 and not g.characters[3].hand.has(guard), "amulet cancels and consumes exactly once "+key)
		g = H.fixture(8);guard = H.give(g,3,key)
		H.begin(g,{0:H.give(g,0,"magic_strike" if key == "magic_amulet" else "strike")});g.target(0,3);g.respond(1,0)
		check(g.characters[3].hand.has(guard) and g.characters[3].hp < 8, "decline keeps amulet and resolves attack "+key)
	# Wrong type, friendly source and deathrattles cannot activate the passive.
	for source_key in ["strike","magic_strike"]:
		var g = H.fixture(8)
		H.give(g,3,"magic_amulet" if source_key == "strike" else "attack_amulet")
		H.begin(g,{0:H.give(g,0,source_key)});g.target(0,3)
		check(g.phase == "review" and g.characters[3].hp < 8, "wrong amulet type does not cancel")
	var g = H.fixture(8);H.give(g,1,"holy_amulet")
	H.begin(g,{0:H.give(g,0,"strike")});g.target(0,1)
	check(g.phase == "review" and g.characters[1].hp == 7, "friendly attack does not activate amulet")
	g = H.fixture(8);H.give(g,3,"holy_amulet")
	var death: int = H.give_death(g,0,"death_sentence")
	g.characters[0].hp = 0;g.characters[0].death_round = g.round_number
	H.begin(g,{});g.target(0,3)
	check(g.characters[3].hp == 0, "amulet never blocks deathrattle")
	for key in ["area_strike","precise_strike"]:
		g = H.fixture(8);var guard: int = H.give(g,4,"attack_amulet")
		H.begin(g,{0:H.give(g,0,key)})
		if key == "precise_strike": g.target(0,3);g.target(0,4)
		check(g.phase == "responding", "multi-target reaction offered before damage")
		g.respond(1,guard)
		check(g.characters.all(func(c):return c.hp == 8), "one amulet cancels entire multi-target card")
	g = H.fixture(8);var guard: int = H.give(g,3,"holy_amulet");g.defiled_cards[guard] = true
	H.begin(g,{0:H.give(g,0,"strike")});g.target(0,3);g.respond(1,guard)
	check(g.characters[3].hp == 8 and g.characters[3].hand.has(guard) and not g.discard.has(guard), "defiled passive works while discard prohibition remains")
	g = H.fixture(8);var first: int = H.give(g,3,"attack_amulet");var second: int = H.give(g,3,"holy_amulet")
	H.begin(g,{0:H.give(g,0,"strike")});g.target(0,3);g.respond(1,0)
	check(g.request.options == [second], "declining one amulet offers remaining matching hand amulet")
	g.respond(1,second)
	check(g.characters[3].hand.has(first) and g.characters[3].hp == 8, "second amulet used without consuming first")
