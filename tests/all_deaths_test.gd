extends SceneTree
const H = preload("res://tests/helpers.gd")
var checks := 0
var failures := 0

func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		push_error("ALL_DEATH_FAIL " + label)

func _initialize() -> void:
	_immortal_and_removal()
	_ghost_and_privilege()
	_draws_and_greed()
	_pain()
	_heart_and_curse()
	_eye_and_badges_and_life()
	print("ALL_DEATH_RESULT checks=%d failures=%d" % [checks,failures])
	quit(0 if failures == 0 else 1)

func die(g, id: int) -> void:
	g.characters[id].hp = 0
	g.characters[id].death_round = g.round_number

func activate(g, owner: int, key: String, target: int = -1) -> int:
	var id: int = H.give_death(g,owner,key)
	if target < 0: target = owner
	g._activate({"actor":owner,"card":id},target)
	if not g.death_revealed.has(id): g.death_revealed.append(id)
	return id

func damage(g, source: int, target: int, amount: int, key: String = "strike") -> bool:
	var id: int = H.give(g,source,key)
	var a := {"id":-9,"actor":source,"card":id}
	return g._damage(a,target,amount)

func _immortal_and_removal() -> void:
	var g = H.fixture()
	H.give_death(g,0,"immortal")
	g.characters[0].hp = 1
	H.begin(g,{0:H.give(g,0,"triple_strike"),3:H.give(g,3,"strike")})
	g.target(1,0)
	check(g.characters[0].hp == 1 and g.characters[0].death_round == 1,"immortal revives within lethal damage event")
	check(H.action_for(g,0).status == "active" and g.phase == "targeting","revival before reveal preserves ordinary card")
	g.target(0,3)
	check(g.death_revealed.has(120) and not g.death_discard.has(120),"immortal revealed and never consumed")
	check(damage(g,3,0,99) and g.characters[0].hp == 1,"each lethal blow creates a death event even after revival")
	die(g,1); die(g,2)
	damage(g,3,0,99)
	check(g.characters[0].hp == 0,"immortal cannot revive without a living teammate")
	g = H.fixture()
	H.give_death(g,0,"mediocrity")
	H.give_death(g,3,"immortal")
	activate(g,3,"blessing",4)
	activate(g,3,"prison",1)
	activate(g,3,"privilege",5)
	die(g,0)
	g._finish_round()
	check(g.request.options == [1,2,3,4,5],"mediocrity only targets living roles")
	g.target(0,3)
	check(g.characters[3].deathrattles == [120],"mediocrity removes every deathrattle except immortal")
	check(not g._has_effect("blessing",4) and not g._has_effect("prison",1) and g._bonus(5) == 0,"losing sources immediately stops all bound persistent effects")
	g = H.fixture()
	activate(g,0,"blessing",3)
	H.begin(g,{1:H.give(g,1,"area_strike")})
	check(g.characters[3].hp == 5 and g.characters[4].hp == 4,"blessing protects only its target against area attack")
	check(damage(g,1,3,99,"judgment") and g.characters[3].hp == 0,"blessing does not protect against skill damage")
	g = H.fixture()
	H.give_death(g,0,"blessing"); die(g,0)
	g._finish_round(); g.target(0,4)
	g._revive(0)
	damage(g,3,0,99,"judgment")
	g._finish_round()
	check(g.phase == "review" and g.death_queue.size() == 1,"already activated persistent card does not requeue on re-death")
	check(g._has_effect("blessing",4) and not g._has_effect("blessing",5),"original bound target retains effect across revival and death")
	g._strip_deaths(0)
	check(not g._has_effect("blessing",4),"original effect still ends when source is lost")

func _ghost_and_privilege() -> void:
	var g = H.fixture()
	H.give_death(g,0,"ghost")
	die(g,0)
	g._finish_round()
	check(g.characters[0].deathrattles == [115] and g._has_effect("ghost",0),"ghost activates and remains held")
	g.confirm(0); g.confirm(1)
	H.begin(g,{3:H.give(g,3,"strike",10)})
	var ghost: Dictionary = g._action(g.current_id)
	check(ghost.actor == 0 and ghost.virtual and ghost.secondary == 100,"ghost attacks posthumously before physical strikes")
	g.target(0,3); g.skip_effect(1)
	check(g.characters[3].hp == 4 and g.characters[0].hp == 0,"ghost damage resolves without revival")
	g._revive(0)
	g.confirm(0); g.confirm(1)
	H.begin(g,{0:H.give(g,0,"collect")})
	check(g.queue.size() == 1 and not g.queue[0].virtual,"playing an ordinary card prevents automatic ghost strike")
	g = H.fixture()
	activate(g,0,"privilege",3)
	H.begin(g,{0:H.give(g,0,"mirror"),3:H.give(g,3,"strike",1)})
	check(g._action(g.current_id).actor == 3 and g._action(g.current_id).main == 105 and g._action(g.current_id).secondary == 101,"privilege raises both priorities and acts first")
	g.skip_effect(1)
	check(g.phase == "review","later mirror cannot choose already revealed privileged card")
	g = H.fixture()
	activate(g,0,"privilege",3)
	H.give_death(g,1,"death_sentence")
	H.give_death(g,3,"vanish")
	die(g,1); die(g,3)
	g._finish_round()
	check(g._death_action().card == 109 and g._death_action().main == 109,"privilege also reorders deathrattles")
	g.skip_effect(1); g.skip_effect(0)

func _draws_and_greed() -> void:
	var g = H.fixture()
	activate(g,0,"divinity")
	die(g,0)
	H.give_death(g,3,"greed")
	die(g,3)
	g._finish_round()
	g.target(1,4)
	check(g.phase == "selecting" and g.request.type == "deck" and g.request.team == 0 and g.request.count == 6,"divinity interrupts greed draw and gives owner six-card selection")
	check(g.snapshot(1).input.options.is_empty() and g.snapshot(0).input.options.size() == 89,"deck choices visible only to divinity controller")
	check(g.skip_effect(0) != "" and g.pick(1,g.deck.slice(0,6)) != "","mandatory god selection cannot be skipped or stolen")
	var cards: Array = g.request.options.slice(0,6)
	check(g.pick(0,[cards[0],cards[0],cards[1],cards[2],cards[3],cards[4]]) != "","duplicate deck selection rejected")
	g.pick(0,cards)
	check(g.request.type == "hand" and g.request.team == 1 and g.characters[4].hand == cards,"greed then prompts recipient to discard their chosen card")
	check(g.snapshot(0).input.options.is_empty(),"recipient's discard selection is private")
	g.pick(1,[cards[2]])
	check(g.phase == "review" and g.characters[4].hand.size() == 5 and g.discard.has(cards[2]),"greed draw and discard both complete")
	g = H.fixture()
	activate(g,0,"divinity"); die(g,0)
	activate(g,1,"prison",4)
	H.give(g,4,"strike")
	g._push([{"op":"draw","target":4,"count":6}]); g._pump()
	check(g.request.is_empty() and g.characters[4].hand.size() == 1,"prison cancels before divinity can replace draw")
	g._discard_hand(g.characters[4])
	g._push([{"op":"draw","target":4,"count":3}]); g._pump()
	check(g.request.type == "deck" and g.request.count == 3,"empty hand under prison can draw the whole batch")
	g.pick(0,g.request.options.slice(0,3))
	check(g.characters[4].hand.size() == 3,"batch draw not stopped after its first card")
	g._revive(0)
	g._push([{"op":"draw","target":5,"count":2}]); g._pump()
	check(g.request.is_empty() and g.characters[5].hand.size() == 2,"divinity pauses while owner lives")
	g = H.fixture()
	H.give_death(g,0,"divinity"); H.give_death(g,1,"legacy")
	die(g,0); die(g,1)
	g._finish_round()
	check(g.phase == "review" and g.characters[2].hand.size() == 5,"unresolved divinity cannot affect earlier legacy draw")
	g = H.fixture()
	activate(g,0,"divinity"); die(g,0)
	g.discard = g.deck.slice(2)
	g.deck = g.deck.slice(0,2)
	g._push([{"op":"draw","target":1,"count":4}]); g._pump()
	check(g.request.count == 2,"god selects available deck before recycling")
	g.pick(0,g.request.options.duplicate())
	check(g.request.count == 2 and g.request.options.size() == g.catalog.size()-2,"remaining draw replenishes from discards and prompts again")
	g.pick(0,g.request.options.slice(0,2))
	check(g.characters[1].hand.size() == 4 and g.deck.size() == g.catalog.size()-4,"resumed batch conserves deck across refill")

func _pain() -> void:
	var g = H.fixture()
	activate(g,0,"pain"); die(g,0)
	H.give_death(g,1,"last_dance"); die(g,1)
	g._revive(1) # Last dance owner's hand is used only after a fresh death below.
	var x: int = H.give(g,2,"strike",10)
	var y: int = H.give(g,2,"strike",9)
	H.begin(g,{2:H.give(g,2,"strike",8)})
	check(g.request.options.has(0),"active pain corpse is a legal ally damage target")
	g.target(0,0)
	check(g.phase == "selecting" and g.request.type == "bonus" and g.request.team == 0,"corpse damage automatically activates pain without confirmation")
	check(g.request.type == "bonus" and g.characters[2].hand.size() == 3,"pain draws first then permits up to two cards")
	g.pick(0,[x,y])
	check(g._action(g.current_id).card == x and g.queue.size() == 3,"extra revealed cards resolve after original card completes")
	g.skip_effect(0); g.skip_effect(0)
	check(g.phase == "review" and g.characters[0].deathrattles.has(111),"pain remains active after extra cards skipped")
	g = H.fixture()
	activate(g,0,"pain"); die(g,0)
	H.give_death(g,1,"last_dance"); die(g,1)
	g._finish_round()
	for hit in range(5):
		g.target(0,0)
		check(g.request.get("type","") != "pain","dance automatically triggers pain without confirmation")
	check(g.phase == "review" and g.characters[0].deathrattles.has(111),"automatic repeated pain never consumes persistent source")
	g = H.fixture()
	activate(g,0,"pain"); die(g,0)
	H.begin(g,{3:H.give(g,3,"strike")})
	check(g.request.options.has(0),"enemies can target pain corpse")
	g.target(1,0)
	check(g.phase == "review" and g.characters[0].hp == 0,"enemy corpse hit does not trigger pain")

func _heart_and_curse() -> void:
	var g = H.fixture()
	H.give_death(g,0,"heart"); die(g,0)
	g._finish_round(); g.target(0,1)
	check(g.characters[1].hand.size() == 2 and g.characters[1].deathrattles == [107] and not g.death_discard.has(107),"heart draws two and transfers physical deathrattle")
	check(g.play_limit(g.characters[1]) == 1,"heart bonus only next round")
	g.confirm(0); g.confirm(1)
	check(g.play_limit(g.characters[1]) == 2,"heart grants two ordinary plays next round")
	var cards: Array = g.characters[1].hand.slice(0,2)
	check(g.submit(0,[0,[cards[0],cards[0]],0]) != "","duplicate physical multi-play rejected")
	check(g.submit(0,[0,cards,0]) == "" and g.submit(1,[0,0,0]) == "","heart's two different cards accepted")
	for _step in range(30):
		if g.phase == "review": break
		if g.request.get("can_skip",false): g.skip_effect(g.request.team)
		elif g.phase == "selecting": g.pick(g.request.team,H.auto_pick(g.snapshot(g.request.team)))
	check(g.queue.size() == 2,"both heart cards entered normal queue")
	g.confirm(0); g.confirm(1)
	check(g.play_limit(g.characters[1]) == 1,"extra play expires after exactly one round")
	g = H.fixture()
	H.give_death(g,0,"curse"); die(g,0)
	H.give_death(g,3,"immortal")
	activate(g,3,"blessing",4)
	g._finish_round(); g.target(0,3)
	check(g.characters[3].hand == [104] and g.characters[0].deathrattles.is_empty(),"curse transfers into ordinary hand")
	g.characters[3].hp = 2
	g.confirm(0); g.confirm(1)
	check(g.characters[3].hp == 1 and g.characters[3].deathrattles == [120],"curse lethal event revives immortal then strips other deaths")
	check(not g._has_effect("blessing",4) and g.characters[3].hand.has(104),"curse remains in hand and removed source loses power")
	check(g.submit(1,[104,0,0]) != "","curse cannot be played as a normal card")
	g._discard_hand(g.characters[3])
	check(g.characters[3].hand.has(104) and not g.death_discard.has(104) and not g.discard.has(104),"curse resists discarding and stays in hand")

func _eye_and_badges_and_life() -> void:
	var g = H.fixture()
	H.give_death(g,0,"eye")
	H.give_death(g,3,"ghost")
	H.give(g,3,"strike")
	die(g,0); g._finish_round()
	var view: Dictionary = g.snapshot(0)
	check(view.omniscient and view.characters[3].hand.size() == 1 and view.characters[3].deathrattles == [115],"eye reveals opponent hand and deathrattles to owner's controller")
	check(not g.snapshot(1).omniscient and g.snapshot(1).characters[0].hand.is_empty(),"opponent does not inherit eye permissions")
	check(view.deck_view == g.deck and view.death_deck_view == g.death_deck,"eye sees both draw piles")
	g._revive(0)
	check(not g.snapshot(0).omniscient and g.snapshot(0).characters[3].hand.is_empty(),"revival suspends eye immediately")
	die(g,0)
	check(g.snapshot(0).omniscient,"eye resumes when its already-active owner is dead")
	g._strip_deaths(0)
	check(not g.snapshot(0).omniscient,"losing eye source revokes view")
	g = H.fixture()
	H.give_death(g,0,"sacrifice_badges"); H.give_death(g,1,"eye")
	g.badges[0] = 2
	die(g,0); die(g,1); g._finish_round()
	check(g.phase == "ended" and g.winner == 0 and g.badges[0] == 4,"sacrifice badges immediately wins at four")
	check(g.death_discard.has(106) and not g._has_effect("eye",1),"winning card consumed and lower priority effects do not run")
	g = H.fixture()
	H.give_death(g,0,"life_steal"); H.give_death(g,0,"eye")
	H.give_death(g,3,"immortal")
	die(g,0); g.characters[3].hp = 2
	g._finish_round(); g.target(0,3)
	check(g.characters[0].hp == 5 and g.characters[3].hp == 1,"life steal rewards actual death event even if victim instantly revives")
	check(g.characters[0].deathrattles == [103] and g.death_discard == [105],"self revival retrieves pending eye but not current consumed life steal")
	g = H.fixture()
	H.give_death(g,0,"life_steal"); die(g,0); g.characters[1].hp = 2
	g._finish_round(); g.target(0,1)
	check(g.characters[0].hp == 0,"life steal cannot resurrect by killing ally")
