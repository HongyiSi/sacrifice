root /srv/sacrifice/web;
index index.html;
gzip on;
gzip_vary on;
gzip_static on;
gzip_types application/wasm application/octet-stream application/javascript text/css;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy same-origin always;
location = /client-diagnostics {
    limit_req zone=sacrifice_diagnostics burst=12 nodelay;
    limit_req_status 429;
    client_max_body_size 1k;
    access_log /var/log/sacrifice-client/diagnostics.log sacrifice_client;
    add_header Cache-Control "no-store";
    # Use a content-phase handler so request rate limiting runs before the 204.
    try_files /__sacrifice_diagnostic_sink_not_a_file__ =204;
}
location = /game {
    proxy_pass http://127.0.0.1:7002;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
}
location = /index.html {
    add_header Cache-Control "no-cache";
    try_files $uri =404;
}
location ~* \.(res|wav|mp3)$ {
    # Original recordings are cached by content hash in the browser.
    gzip off;
    default_type application/octet-stream;
    types { audio/wav wav; audio/mpeg mp3; application/octet-stream res; }
    add_header Cache-Control "no-cache";
    try_files $uri =404;
}
location ~* \.(js|wasm|pck)$ {
    add_header Cache-Control "no-cache";
    types { application/javascript js; application/wasm wasm; application/octet-stream pck; }
    try_files $uri =404;
}
location / { try_files $uri $uri/ =404; }
