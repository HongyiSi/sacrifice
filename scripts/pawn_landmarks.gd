static func sole(art:String)->PackedVector2Array:
	var points=PackedVector2Array()
	for p in SOLES[art]:points.append(Vector2(p[0],p[1]-6))
	return points
static func local_pixel(sprite:Control,p:Vector2)->Vector2:
	var tex:AtlasTexture=sprite.texture
	var factor=minf(sprite.size.x/tex.region.size.x,sprite.size.y/tex.region.size.y)
	return (sprite.size-tex.region.size*factor)*.5+(p-tex.region.position)*factor
static func head(sprite:Control)->Vector2:
	return local_pixel(sprite,HEAD[sprite.get_meta("pawn_art")])
